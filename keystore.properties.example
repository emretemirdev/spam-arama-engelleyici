# Bu dosyayı "keystore.properties" adıyla kopyala ve kendi değerlerini yaz.
# keystore.properties ve .jks dosyası .gitignore'da; ASLA repoya ekleme.
#
# Anahtar oluşturmak için (bir kez, Android Studio ile gelen JDK'daki keytool ile):
#   keytool -genkeypair -v -keystore upload-key.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Bu bir "yükleme anahtarı"dır. Play App Signing açıkken asıl imzayı Google tutar;
# yükleme anahtarını kaybedersen Play Console'dan sıfırlatabilirsin. Yine de güvenli bir yere yedekle.

storeFile=upload-key.jks
storePassword=SIFRE
keyAlias=upload
keyPassword=SIFRE
